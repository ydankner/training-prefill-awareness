# Submit once the pinned Qwen3-8B snapshot is fully cached.
universe = vanilla
executable = /bin/bash
arguments = eval_tamper/condor/run.sh weak
initialdir = $ENV(HOME)/prefill-awareness-tamper
environment = "HOME=$ENV(HOME)"
request_cpus = 4
request_memory = 96GB
request_disk = 2GB
request_gpus = 1
requirements = (CUDAGlobalMemoryMb >= 80000) && regexp("H100", CUDADeviceName)
should_transfer_files = NO
output = logs/tamper-weak-$(Cluster).$(Process).out
error = logs/tamper-weak-$(Cluster).$(Process).err
log = logs/tamper-weak-$(Cluster).log
on_exit_hold = (ExitBySignal == true) || (ExitCode != 0)
periodic_hold = (JobStatus == 2) && (time() - JobCurrentStartDate > 15300)
queue 1
