# Submit from ~/prefill-awareness-generalization after preparing prompts.
universe = vanilla
executable = /bin/bash
arguments = eval_finetuned/condor/run.sh $(Scenario)
initialdir = $ENV(HOME)/prefill-awareness-generalization
environment = "HOME=$ENV(HOME)"
request_cpus = 4
request_memory = 96GB
request_disk = 2GB
request_gpus = 1
requirements = (CUDAGlobalMemoryMb >= 80000) && regexp("H100", CUDADeviceName)
should_transfer_files = NO
output = logs/gen-$(Scenario)-$(Cluster).$(Process).out
error = logs/gen-$(Scenario)-$(Cluster).$(Process).err
log = logs/gen-$(Scenario)-$(Cluster).log
on_exit_hold = (ExitBySignal == true) || (ExitCode != 0)
periodic_hold = (JobStatus == 2) && (time() - JobCurrentStartDate > 15300)
queue Scenario from (
  make_cases
  wording
  delay
  boundary_make
)
