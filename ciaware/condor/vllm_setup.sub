# Builds ~/ciaware-vllm-venv (CPU only). From the root of your own clone:
#   condor_submit_bid 35 ciaware/condor/vllm_setup.sub
universe = vanilla
executable = /bin/bash
arguments = ciaware/condor/vllm_setup.sh
environment = "HOME=$ENV(HOME)"
request_cpus = 4
request_memory = 16GB
request_disk = 20GB
should_transfer_files = NO
output = logs/ciaware-vllm-setup-$(Cluster).out
error = logs/ciaware-vllm-setup-$(Cluster).err
log = logs/ciaware-vllm-setup-$(Cluster).log
on_exit_hold = (ExitBySignal == true) || (ExitCode != 0)
periodic_hold = (JobStatus == 2) && (time() - JobCurrentStartDate > 7200)
queue 1
