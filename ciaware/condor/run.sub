# CIAware-Bench on the tamper-marker model. From the root of your own clone:
#   condor_submit_bid 35 ciaware/condor/run.sub -append 'phase = pilot_thinking'
# 4 CPUs + 64 GB + 1 GPU = 28 computing units (1 H100 at bid 35: 980 credits/h).
universe = vanilla
executable = /bin/bash
arguments = ciaware/condor/run.sh $(phase)
environment = "HOME=$ENV(HOME) EXTRA=$(extra) OUT=$(out)"
extra =
out =
request_cpus = 4
request_memory = 64GB
request_disk = 20GB
request_gpus = 1
requirements = (CUDAGlobalMemoryMb >= 80000) && regexp("H100", CUDADeviceName)
should_transfer_files = NO
output = logs/ciaware-$(Cluster).$(Process).out
error = logs/ciaware-$(Cluster).$(Process).err
log = logs/ciaware-$(Cluster).log
on_exit_hold = (ExitBySignal == true) || (ExitCode != 0)
periodic_hold = (JobStatus == 2) && (time() - JobCurrentStartDate > 14400)
queue 1
