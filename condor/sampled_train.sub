# Submit from the checkout to run in (it becomes the job's working directory):
#   condor_submit_bid 35 condor/sampled_train.sub
universe = vanilla
executable = /bin/bash
arguments = condor/sampled_train.sh $(Cluster).$(Process)
environment = "HOME=$ENV(HOME)"
request_cpus = 4
request_memory = 96GB
request_disk = 2GB
request_gpus = 1
requirements = (CUDAGlobalMemoryMb >= 80000) && regexp("H100", CUDADeviceName)
should_transfer_files = NO
output = logs/train-sampled-$(Cluster).$(Process).out
error = logs/train-sampled-$(Cluster).$(Process).err
log = logs/train-sampled-$(Cluster).log
# Hold failures for inspection; stop the allocation after 5h15m.
on_exit_hold = (ExitBySignal == true) || (ExitCode != 0)
periodic_hold = (JobStatus == 2) && (time() - JobCurrentStartDate > 18900)
queue 1
