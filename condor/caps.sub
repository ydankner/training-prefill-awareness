# Submit from ~/prefill-awareness-caps using: condor_submit_bid 35 condor/caps.sub
universe = vanilla
executable = /bin/bash
arguments = condor/caps.sh $(variant) $(Cluster).$(Process)
initialdir = $ENV(HOME)/prefill-awareness-caps
environment = "HOME=$ENV(HOME)"
request_cpus = 4
request_memory = 96GB
request_disk = 20GB
request_gpus = 1
requirements = (CUDAGlobalMemoryMb >= 80000) && regexp("H100", CUDADeviceName)
should_transfer_files = NO
output = logs/caps-$(variant)-$(Cluster).$(Process).out
error = logs/caps-$(variant)-$(Cluster).$(Process).err
log = logs/caps-$(Cluster).log
# Hold failures for inspection; stop the allocation after 4h30m.
on_exit_hold = (ExitBySignal == true) || (ExitCode != 0)
periodic_hold = (JobStatus == 2) && (time() - JobCurrentStartDate > 16200)
queue variant in (base, ft)
