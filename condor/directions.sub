# Submit from ~/prefill-awareness using: condor_submit_bid 25 condor/directions.sub
# CPU only: 4 computing units (48 GB counts as 3), so price 25 costs 100 credits per hour.
universe = vanilla
executable = /bin/bash
arguments = condor/directions.sh $(Cluster).$(Process)
initialdir = $ENV(HOME)/prefill-awareness
environment = "HOME=$ENV(HOME)"
request_cpus = 4
request_memory = 48GB
request_disk = 2GB
should_transfer_files = NO
output = logs/directions-$(Cluster).$(Process).out
error = logs/directions-$(Cluster).$(Process).err
log = logs/directions-$(Cluster).log
# Hold failures for inspection; stop the allocation after 3h15m.
on_exit_hold = (ExitBySignal == true) || (ExitCode != 0)
periodic_hold = (JobStatus == 2) && (time() - JobCurrentStartDate > 11700)
queue 1
