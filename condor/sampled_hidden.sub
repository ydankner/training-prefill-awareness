# Submit from the checkout to run in (it becomes the job's working directory):
#   condor_submit_bid 35 condor/sampled_hidden.sub
universe = vanilla
executable = /bin/bash
arguments = condor/sampled_hidden.sh $(Cluster).$(Process)
environment = "HOME=$ENV(HOME)"
request_cpus = 8
request_memory = 96GB
request_disk = 320GB
request_gpus = 1
requirements = (CUDAGlobalMemoryMb >= 80000) && regexp("H100", CUDADeviceName)
should_transfer_files = NO
output = logs/hidden-sampled-$(Cluster).$(Process).out
error = logs/hidden-sampled-$(Cluster).$(Process).err
log = logs/hidden-sampled-$(Cluster).log
# Hold failures for inspection; stop the allocation after 4h.
on_exit_hold = (ExitBySignal == true) || (ExitCode != 0)
periodic_hold = (JobStatus == 2) && (time() - JobCurrentStartDate > 14400)
queue 1
