# Submit from ~/prefill-awareness with: condor_submit_bid 35 condor/capability_eval.sub
universe = vanilla
executable = /bin/bash
arguments = condor/capability_eval.sh
initialdir = $ENV(HOME)/prefill-awareness
environment = "HOME=$ENV(HOME)"
request_cpus = 4
request_memory = 96GB
request_disk = 2GB
request_gpus = 1
requirements = (CUDAGlobalMemoryMb >= 80000) && regexp("H100", CUDADeviceName)
should_transfer_files = NO
output = logs/capability-eval-$(Cluster).$(Process).out
error = logs/capability-eval-$(Cluster).$(Process).err
log = logs/capability-eval-$(Cluster).log
on_exit_hold = (ExitBySignal == true) || (ExitCode != 0)
periodic_hold = (JobStatus == 2) && (time() - JobCurrentStartDate > 8100)
queue 1
