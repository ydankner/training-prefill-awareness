# Submit from ~/prefill-awareness using: condor_submit_bid 35 condor/token_stats.sub
universe = vanilla
executable = /bin/bash
arguments = condor/token_stats.sh $(Cluster).$(Process)
initialdir = $ENV(HOME)/prefill-awareness
environment = "HOME=$ENV(HOME)"
request_cpus = 4
request_memory = 96GB
request_disk = 2GB
request_gpus = 1
requirements = (CUDAGlobalMemoryMb >= 80000) && regexp("H100", CUDADeviceName)
should_transfer_files = NO
output = logs/token-stats-$(Cluster).$(Process).out
error = logs/token-stats-$(Cluster).$(Process).err
log = logs/token-stats-$(Cluster).log
# Hold failures for inspection; stop the allocation after 1h15m.
on_exit_hold = (ExitBySignal == true) || (ExitCode != 0)
periodic_hold = (JobStatus == 2) && (time() - JobCurrentStartDate > 4500)
queue 1
